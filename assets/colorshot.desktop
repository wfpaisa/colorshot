[Desktop Entry]
Type=Application
Name=ColorShot
Comment=Screenshots with annotations, OCR and pinning
Comment[es]=Capturas de pantalla con anotaciones, OCR y fijado
Exec=colorshot
Icon=colorshot
Terminal=false
Categories=Graphics;
Keywords=screenshot;capture;ocr;annotate;
StartupWMClass=colorshot
# Sin esto GNOME añade «New Window», que solo vuelve a lanzar el proceso de la bandeja.
SingleMainWindow=true
Actions=area;full;window;ocr;color;palettes;last;folder;prefs;welcome;

[Desktop Action area]
Name=Capture Area
Name[es]=Capturar área
Name[pt]=Capturar área
Name[fr]=Capturer une zone
Name[de]=Bereich aufnehmen
Name[ru]=Снимок области
Name[zh_CN]=截取区域
Name[ja]=範囲をキャプチャ
Exec=colorshot area

[Desktop Action full]
Name=Capture Screen
Name[es]=Capturar pantalla
Name[pt]=Capturar tela
Name[fr]=Capturer l’écran
Name[de]=Bildschirm aufnehmen
Name[ru]=Снимок экрана
Name[zh_CN]=截取屏幕
Name[ja]=画面をキャプチャ
Exec=colorshot full

[Desktop Action window]
Name=Capture Window
Name[es]=Capturar ventana
Name[pt]=Capturar janela
